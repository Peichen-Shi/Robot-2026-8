+  roslaunch controller_pkg lab4_visualization.launch     rviz_config:="$PWD/code/controller_pkg/rviz/lab4_topdown.rviz"     > "results/${prefix}_view.log" 2>&1 9>&- &
+  viewer_pid=$!
