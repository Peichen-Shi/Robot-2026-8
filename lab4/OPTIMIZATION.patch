+                metadata = tesse_ros_bridge.utils.parse_metadata(sim_data)
+
+                curr_ros_time = rospy.Time.from_sec(metadata['time'])
+                if self.publish_clock and not self.clock_from_metadata_udp:
+                    self.clock_pub.publish(curr_ros_time)
