+  fi
+  if [[ -n "$flight_pid" ]]; then
+    kill -TERM "$flight_pid" 2>/dev/null || true
+    wait "$flight_pid" 2>/dev/null || true
+  fi
+  if [[ -n "$viewer_pid" ]]; then
+    kill -INT "$viewer_pid" 2>/dev/null || true
