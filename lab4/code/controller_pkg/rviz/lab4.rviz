Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LAB4 Visualization1
      Splitter Ratio: 0.55
    Tree Height: 520
  - Class: rviz/Views
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.28
      Cell Size: 1
      Class: rviz/Grid
      Color: 135; 142; 150
      Enabled: true
      Line Style:
        Line Width: 0.01
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: -23
        Y: 3
        Z: 0
      Plane: XY
      Plane Cell Count: 60
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /lab4_visualization/markers
      Name: LAB4 Visualization
      Namespaces:
        actual_path: true
        body_axes: true
        desired_path: true
        desired_setpoint: true
        legend: true
        quadrotor: true
        race_gates: true
        gate_numbers: true
      Queue Size: 20
      Value: true
  Enabled: true
  Global Options:
    Background Color: 27; 31; 36
    Default Light: true
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 55
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: -23
        Y: 3
        Z: 3.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Oblique Overview
      Near Clip Distance: 0.01
      Pitch: 0.62
      Target Frame: world
      Value: Orbit (rviz)
      Yaw: 0.78
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 836
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1368
  X: 72
  Y: 27
