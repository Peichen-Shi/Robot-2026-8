<launch>
  <arg name="target_duration" default="14.0"/>
  <arg name="terminal_segment_time" default="1.8"/>
  <arg name="run_id" default="fast-live"/>
  <arg name="rviz" default="false"/>
  <arg name="visualization" default="false"/>
  <arg name="gates_output_csv" default="$(env HOME)/lab4_fast_results/gates.csv"/>
  <include file="$(find planner_pkg)/launch/lab4_race.launch">
    <arg name="controller_config" value="$(find controller_pkg)/config/lab4_aggressive.yaml"/>
    <arg name="target_duration" value="$(arg target_duration)"/>
    <arg name="terminal_segment_time" value="$(arg terminal_segment_time)"/>
    <arg name="time_scale" value="1.0"/>
    <arg name="kx" value="18.0"/>
    <arg name="kv" value="8.5"/>
    <arg name="kr" value="10.0"/>
    <arg name="komega" value="2.8"/>
    <arg name="ready_hold_duration" value="0.5"/>
    <arg name="post_hold_duration" value="75.0"/>
    <arg name="publish_frequency" value="100.0"/>
    <arg name="run_id" value="$(arg run_id)"/>
    <arg name="gates_output_csv" value="$(arg gates_output_csv)"/>
    <arg name="visualization" value="$(arg visualization)"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
